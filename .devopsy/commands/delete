#!/bin/sh
## Description: Delete tags, or every tag of a repository, then gc frees their space
# Usage: devopsy delete <repository>[:<tag>]... [--yes]
#
# Deletes each tag, as the push user; a repository without a tag means all
# of its tags. Only the tags go: an image other tags still point to stays
# (`devopsy images` shows which share a digest), and a repository stays
# listed, with no tags. Nothing is freed until `devopsy gc`. Servers that
# ran a deleted tag keep their copy for rollbacks; a new release of it
# fails.
#
# It lists every tag first and asks to type `delete`, or `delete all` when
# a whole repository goes. --yes skips it, and is the only way without a
# terminal.
set -eu
yes=
all=
args=
for a in "$@"; do
  case $a in
    --yes) yes=1 ;;
    -*)
      echo "delete: unknown option $a" >&2
      exit 2
      ;;
    *:*) args="$args $a" ;;
    *)
      args="$args $a"
      all=1
      ;;
  esac
done
if [ -z "$args" ]; then
  echo "usage: devopsy delete <repository>[:<tag>]... [--yes]" >&2
  exit 2
fi
if [ -z "$yes" ] && [ ! -t 0 ]; then
  echo "delete: not a terminal: add --yes to delete$args" >&2
  exit 2
fi

# set -- word-splits $args on purpose: names have no spaces.
# shellcheck disable=SC2086
set -- $args
# Every tag that goes, one repository:tag per line: a repository's from
# its listing, which fails for one the registry does not have.
refs=$(devopsy run --rm --no-deps -T crane sh -c '
set -eu
for a in "$@"; do
  case $a in
    *:*) echo "$a" ;;
    *)
      tags=$(crane --insecure ls "registry:5000/$a")
      [ -n "$tags" ] || echo "delete: $a has no tags" >&2
      printf "%s\n" "$tags" | sed "/^\$/d; s|^|$a:|"
      ;;
  esac
done
' delete "$@")
if [ -z "$refs" ]; then
  echo "delete: no tags to delete" >&2
  exit 0
fi

n=$(echo "$refs" | wc -l | tr -d ' ')
[ "$n" = 1 ] && echo "delete: 1 tag:" >&2 || echo "delete: $n tags:" >&2
echo "$refs" | sed 's/^/  /' >&2
if [ -z "$yes" ]; then
  phrase=delete
  [ -z "$all" ] || phrase="delete all"
  printf "Type '%s' to go on: " "$phrase" >&2
  read -r answer
  if [ "$answer" != "$phrase" ]; then
    echo "delete: nothing deleted" >&2
    exit 1
  fi
fi

# shellcheck disable=SC2086
set -- $refs
devopsy run --rm --no-deps -T crane sh -c '
set -eu
for ref in "$@"; do
  crane --insecure delete "registry:5000/$ref"
  echo "delete: $ref" >&2
done
' delete "$@"
echo "delete: devopsy gc frees the space" >&2
