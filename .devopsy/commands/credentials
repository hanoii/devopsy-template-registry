#!/bin/sh
## Description: Print the registry's URL, users and passwords for docker login (push, pull or both)
# `credentials push` is the user that pushes and pulls, for CI and build
# hosts; `credentials pull` the read-only one, for the servers that run the
# images; no argument prints both.
set -eu
env_file="$DEVOPSY_PROJECT_DIR/.env"
# SITE_HOST: capabilities/env/compute.
host="${SITE_HOST:-app.localhost}"
env_get() { sed -n "s/^$1=//p" "$env_file" 2>/dev/null | tail -n 1; }
which="${1:-both}"
case $which in
  push | pull | both) ;;
  *)
    echo "usage: devopsy credentials [push|pull]" >&2
    exit 2
    ;;
esac
if [ -z "$(env_get REGISTRY_PASSWORD)" ]; then
  echo "credentials: no REGISTRY_PASSWORD in .env yet: run deploy first" >&2
  exit 1
fi

# show LABEL USER PASSWORD
show() {
  echo "$1"
  echo "  user:     $2"
  echo "  password: $3"
  echo "  docker login $host -u $2 --password-stdin"
}
echo "registry: $host"
if [ "$which" != pull ]; then
  user="$(env_get REGISTRY_USER)"
  show "push and pull (CI, build hosts):" "${user:-devopsy}" "$(env_get REGISTRY_PASSWORD)"
fi
if [ "$which" != push ]; then
  user="$(env_get REGISTRY_PULL_USER)"
  show "pull only (servers running the images):" "${user:-pull}" "$(env_get REGISTRY_PULL_PASSWORD)"
fi
